# ============================================================
#  E:\brain 真源仓库 .gitignore
#  铁律：密钥与运行时数据永不入库（2026-09-16 荣总确认）
# ============================================================

# --- 密钥与凭证：绝对禁止入库 ---
settings.json
models.json
*.env
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.git-credentials
*secret*
*token*
*credential*

# --- 运行时 / 可再生数据 ---
logs/
traces/
cache/
binaries/
projects/
sessions/
shell-snapshots/
file-history/
changes-detail/
changes-index/
blobs/
audit-log/
artifact-index/
__pycache__/
*.pyc
.venv/
venv/
env/
node_modules/
*.log

# --- 大文件素材（走网盘或 LFS，不进普通 Git）---
30-素材/**/*.mp4
30-素材/**/*.mov
30-素材/**/*.avi
30-素材/**/*.mkv
30-素材/**/*.zip
30-素材/**/*.7z
30-素材/**/*.rar
30-素材/**/*.iso
30-素材/**/*.wav
30-素材/**/*.psd

# --- 系统与编辑器垃圾 ---
Thumbs.db
desktop.ini
.DS_Store
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/
$RECYCLE.BIN/

# --- 备份产物（含旧版规则副本，不进仓库）---
*.bak
*.orig

# --- 程序家居目录：本次迁移后 .workbuddy 会落在本仓库内 ---
#     只放行"规则文件"，其余（运行时/密钥/日志）全部忽略
/.workbuddy/*
!/.workbuddy/SOUL.md
!/.workbuddy/IDENTITY.md
!/.workbuddy/USER.md
!/.workbuddy/MEMORY.md
!/.workbuddy/AGENTS.md
!/.workbuddy/沉淀架构设计.md
!/.workbuddy/认知盲区双轨框架.md
!/.workbuddy/认知盲区证据台账.md
!/.workbuddy/check_rules.py
!/.workbuddy/tools/
!/.workbuddy/skills/

# 技能库里可能夹带嵌套仓库与依赖，不入库
!/.workbuddy/skills/**/.git/
/.workbuddy/skills/**/node_modules/
/.workbuddy/skills/**/__pycache__/

# --- 临时 / 一次性 ---
_scan_*.py
_probe*.py
_recon*.py
_diag_*.py
_migrate_*.py
_mk_*.py
_git_init.py
_secrets_*.py
_audit_*.json
*.tmp
~$*
